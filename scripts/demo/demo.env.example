# Variables de la demo local (runbook-demo-local.md). VALORES DE EJEMPLO SOLO LOCALES: no son secretos reales y no
# sirven fuera de esta máquina. Copiar a demo.env (ignorado por git) y cargar con: set -a; . scripts/demo/demo.env; set +a
SPRING_PROFILES_ACTIVE=dev
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/paxfide_demo?replicaSet=rs0
# Ganache: cuenta determinista #0, pública y sin valor (la misma que usan los tests). NUNCA una clave de testnet real.
WEB3_NODE_URL=http://localhost:8545
WEB3_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d
# Salida de scripts/demo/deploy-anchor-registry.sh
CRYPTO_ANCHOR_SMART_CONTRACT=
CRYPTO_ANCHOR_NETWORK=ganache-local
CRYPTO_ANCHOR_CHAIN_ID=1337
CRYPTO_ANCHOR_CONFIRMATIONS_REQUIRED=0
# Ritmo del anclaje para la demo (por defecto: 60 s, 30 s y 15 s)
TRACEABILITY_ANCHOR_PRODUCER_INTERVAL_MS=5000
CRYPTO_ANCHOR_SUBMIT_DELAY=3000
CRYPTO_ANCHOR_POLL_DELAY=3000
# Secretos de ejemplo, solo locales (>= 32 caracteres)
TRACKING_CODE_SECRET=demo-local-tracking-code-secret-0000000000
ASSET_REF_SECRET=demo-local-asset-ref-secret-000000000000000
TRACEABILITY_DEMO_WEBHOOK_SECRET=demo-local-webhook-secret-0000000000000000
# Clave del cursor opaco del descubrimiento (DD-53): 32 bytes en Base64, distinta de los demás secretos.
# Ejemplo local; para otra máquina, generar una con: openssl rand -base64 32
TRACEABILITY_DISCOVERY_CURSOR_KEY=ZGVtby1sb2NhbC1jdXJzb3Ita2V5LTMyLWJ5dGVzLSE=
# Semilla de la demo (perfil dev)
TRACEABILITY_DEMO_SEED_ENABLED=true
TRACEABILITY_DEMO_SEED_PASSWORD=demo-local-password
# Correo (ADR-049): el perfil dev ya apunta a Mailpit (localhost:1025) con remitente y web locales. Para Gmail, en la
# terminal y nunca en este fichero: SPRING_MAIL_HOST=smtp.gmail.com, SPRING_MAIL_PORT=587, SPRING_MAIL_USERNAME,
# SPRING_MAIL_PASSWORD (contraseña de aplicación), SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true y
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true.
TRACEABILITY_WEB_BASE_URL=http://localhost:5173
# Opcionales: frontend local y LLM real (sin clave, la narrativa usa el texto de respaldo)
TRACEABILITY_CORS_ALLOWED_ORIGINS=http://localhost:5173
# SPRING_AI_OPENAI_API_KEY=
