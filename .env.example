# =============================================================================
# TRACEABILITY ENGINE — Variables de entorno
# =============================================================================
# ⚠  NUNCA commitear este archivo. Está en .gitignore.
# Uso: `export $(grep -v '^#' .env | xargs)` antes de `mvn spring-boot:run`
#      o configura tu IDE (IntelliJ: Run Config > EnvFile plugin / Edit Env Vars)
# =============================================================================

# ── Web3j: nodo RPC y wallet ──────────────────────────────────────────────────
# Mapea a: crypto.web3j.node-url  (Web3Configuration @ConfigurationProperties)
WEB3_NODE_URL=

# Mapea a: crypto.web3j.private-key  (Web3Configuration @ConfigurationProperties)
# Clave privada de la wallet de prueba en Sepolia — SOLO para desarrollo
WEB3_PRIVATE_KEY=
# ── Anchor: red y contrato ────────────────────────────────────────────────────
# Mapea a: crypto.anchor.network  (BlockchainAnchorScheduler @Value)
CRYPTO_ANCHOR_NETWORK=sepolia

# Mapea a: crypto.anchor.smart-contract  (BlockchainAnchorScheduler @Value)
CRYPTO_ANCHOR_SMART_CONTRACT=

# Mapea a: crypto.anchor.chain-id  (Web3jBlockchainAnchorAdapter @Value)
# 11155111 = Sepolia testnet
CRYPTO_ANCHOR_CHAIN_ID=11155111

# ── Anchor: confirmaciones ────────────────────────────────────────────────────
# Mapea a: crypto.anchor.confirmations-required  (AnchorConfirmationPoller @Value)
# Sepolia produce un bloque ~12s → 12 confirmaciones ≈ 2-3 minutos reales
# Reduce a 1 o 2 durante desarrollo inicial si quieres ciclos rápidos
CRYPTO_ANCHOR_CONFIRMATIONS_REQUIRED=12

# ── Traceability: secrets de seguridad ───────────────────────────────────────
# Mapea a: traceability.security.tracking-code-secret
TRACKING_CODE_SECRET=dev-tracking-code-secret-replace-in-prod

# Mapea a: traceability.security.asset-ref-secret
ASSET_REF_SECRET=dev-asset-ref-secret-replace-in-prod

# ── Spring AI: OpenAI ─────────────────────────────────────────────────────────
# Mapea a: spring.ai.openai.api-key  (OpenAiAutoConfiguration)
# Reemplaza con tu key real — NUNCA commitear
SPRING_AI_OPENAI_API_KEY=groq
