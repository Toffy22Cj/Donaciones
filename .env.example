# PaxFide Environment Variables
# -----------------------------
# Core Security Secrets
#
# These secrets are required for application startup. They are used for HMAC generation and validation.
# Generate a secure 32-byte hex value for development using the following command:
# openssl rand -hex 32
#
# Do NOT share these values or commit them to source control.

# Secret used to generate the verifiable tracking code for donors (ADR-021-B).
TRACKING_CODE_SECRET=

# Secret used to generate the verifiable asset reference ID for the Blockchain (ADR-021-D).
# MUST BE DISTINCT from TRACKING_CODE_SECRET.
ASSET_REF_SECRET=

# Convocatoria
# -----------------------------
# Vigencia de una intención de donación BANK_TRANSFER (ISO-8601, p. ej. PT72H).
# Parámetro de implementación sin valor de producto decidido (implementation_plan.md §9); requerido al arrancar.
CONVOCATORIA_BANK_TRANSFER_EXPIRATION=

# Almacenamiento de imágenes (ADR-051 F1)
# -----------------------------
# Proveedor compatible con S3 (por ejemplo, Cloudflare R2) con bucket privado. Fuera del perfil dev las cinco son
# obligatorias: sin cualquiera de ellas la aplicación no arranca. En dev se usa un directorio local y no hacen falta.
# Nunca en ficheros versionados ni en logs.
# Endpoint del proveedor, p. ej. https://<cuenta>.r2.cloudflarestorage.com
MEDIA_S3_ENDPOINT=
# Región; en R2, auto
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
