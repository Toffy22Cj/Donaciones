<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.traceability</groupId>
    <artifactId>traceability-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- T-01 paso 1 (plan de evolución §2.2, aprobado el 2026-11-14): último parche de la línea 3.4.
             La línea 3.4 ya no tiene soporte OSS; migrar a 4.x o aceptar el riesgo lo decide ADR-052 -->
        <spring-boot.version>3.4.13</spring-boot.version>
        <!-- ADR-047 D1: no la gestiona ningún BOM; se fija a mano y se actualiza como dependencia de seguridad -->
        <nimbus-jose-jwt.version>10.10</nimbus-jose-jwt.version>
        <!-- ADR-051 F1: no la gestiona el BOM de Spring Boot 3.4.4 ni el de Spring AI; se fija a mano.
             2.55.10 (Maven Central, 2026-10-01): con al menos dos semanas de antigüedad al fijarla (2026-10-20) -->
        <awssdk.version>2.55.10</awssdk.version>
    </properties>

    <modules>
        <module>contracts</module>
        <module>core</module>
        <module>crypto</module>
        <module>ai</module>
        <module>api</module>
        <module>identity</module>
        <module>convocatoria</module>
        <module>app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring AI BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.0.0-M6</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
            <!-- ADR-051 F1: cliente S3, solo en app, con el cliente HTTP de la JDK -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>s3</artifactId>
                <version>${awssdk.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>url-connection-client</artifactId>
                <version>${awssdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Required for Spring AI Milestones -->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!-- T-07 (ADR-055): escaneo de dependencias y SBOM, fuera del ciclo normal. Uso:
           NVD_API_KEY=... mvn -B -Psecurity -DskipTests verify
         Falla con CVSS >= 7 salvo supresión justificada y con fecha de caducidad en
         Documentos/seguridad/dependency-check-supresiones.xml (registro humano: excepciones-dependencias.md).
         SBOM CycloneDX del reactor en target/bom.json; informe en target/dependency-check-report.{html,json}. -->
    <profiles>
        <profile>
            <id>security</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.9.3</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>sbom</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>makeAggregateBom</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <outputFormat>json</outputFormat>
                            <outputName>bom</outputName>
                            <includeTestScope>false</includeTestScope>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>13.0.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>scan</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <suppressionFiles>
                                <suppressionFile>${maven.multiModuleProjectDirectory}/Documentos/seguridad/dependency-check-supresiones.xml</suppressionFile>
                            </suppressionFiles>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <skipTestScope>true</skipTestScope>
                            <!-- el backend no lleva JavaScript ni .NET; OSS Index exige credenciales propias -->
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                            <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                            <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
